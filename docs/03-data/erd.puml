@startuml erd
title ERD — MySQL 8.4 (InnoDB, utf8mb4) [P] — <<C>> confirmed entity, <<P>> proposed, <<post>> later
hide circle
skinparam linetype ortho
' Note: table is game_match because MATCH is a MySQL reserved word.
' Conventions: PK id BIGINT UNSIGNED AUTO_INCREMENT unless noted; timestamps DATETIME(3) UTC.

entity user_account <<C>> {
  * id : BIGINT PK
  --
  * username : VARCHAR(32) UNIQUE
  email : VARCHAR(254) UNIQUE NULL [TBD OQ-AC-01]
  password_hash : VARCHAR(255) NULL
  * status : ENUM(ACTIVE,SUSPENDED,DELETION_PENDING,DELETED)
  * created_at : DATETIME(3)
  last_login_at : DATETIME(3)
}
entity auth_session <<P>> {
  * id : BIGINT PK
  --
  * user_id : FK
  * refresh_token_hash : BINARY(32) UNIQUE
  * platform : VARCHAR(16)
  * client_version : VARCHAR(32)
  * expires_at : DATETIME(3)
  revoked_at : DATETIME(3)
}
entity player_profile <<C>> {
  * user_id : PK FK
  --
  * display_name : VARCHAR(32) UNIQUE [A-09]
  avatar_ref : VARCHAR(64)
  * updated_at : DATETIME(3)
}
entity role <<P>> {
  * code : VARCHAR(32) PK
  --
  description : VARCHAR(255)
}
entity user_role <<P>> {
  * user_id : FK
  * role_code : FK
  --
  * granted_by : FK user_account
  * granted_at : DATETIME(3)
}
entity item_definition <<C>> {
  * id : BIGINT PK
  --
  * item_key : VARCHAR(64) UNIQUE
  * category : VARCHAR(32) [TBD categories]
  * display_name : VARCHAR(64)
  * stats_json : JSON [TBD schema]
  * content_version : VARCHAR(16)
  * is_starter : BOOLEAN
  * is_enabled : BOOLEAN
}
entity inventory_item <<C>> {
  * id : BIGINT PK
  --
  * user_id : FK
  * item_definition_id : FK
  * source : ENUM(STARTER,ADMIN_GRANT,REWARD,CHEST) [extensible]
  * acquired_at : DATETIME(3)
}
entity loadout <<C>> {
  * id : BIGINT PK
  --
  * user_id : FK
  * name : VARCHAR(32)
  * is_active : BOOLEAN
}
entity loadout_slot <<P>> {
  * loadout_id : FK
  * slot_type : VARCHAR(32) [TBD]
  --
  * inventory_item_id : FK
}
entity room <<C>> {
  * id : BIGINT PK
  --
  * code : CHAR(8)
  * host_user_id : FK
  * mode : ENUM(FFA)
  * status : ENUM(OPEN,STARTING,IN_MATCH,POST_MATCH,CLOSED)
  * visibility : ENUM(PRIVATE) [TBD]
  * created_at : DATETIME(3)
  * last_activity_at : DATETIME(3)
  active_code : CHAR(8) UNIQUE NULL (generated: code if status<>CLOSED)
}
entity room_member <<C>> {
  * room_id : FK
  * user_id : FK
  --
  * role : ENUM(COMPETITOR,SPECTATOR)
  * is_ready : BOOLEAN
  loadout_id : FK NULL
  * joined_at : DATETIME(3)
}
entity game_match <<C>> {
  * id : BINARY(16) PK (UUIDv7)
  --
  room_id : FK NULL
  * mode : ENUM(FFA)
  * stake_type : ENUM(NONE) [BR-009]
  * status : ENUM(ALLOCATING,WAITING_FOR_PLAYERS,PRE_LAUNCH,BATTLE,ENDED,COMPLETED,CANCELLED,ABORTED,DISPUTED)
  end_reason : VARCHAR(32)
  * server_instance_id : VARCHAR(64)
  * protocol_version : INT
  * content_version : VARCHAR(16)
  * client_build_min : VARCHAR(32)
  * created_at : DATETIME(3)
  started_at : DATETIME(3)
  ended_at : DATETIME(3)
  duration_ms : INT
}
entity match_participant <<C>> {
  * match_id : FK
  * user_id : FK
  --
  * slot : TINYINT (1..5) [BR-001]
  side_id : TINYINT NULL [post: Team Battle]
  * loadout_snapshot_json : JSON
  placement : TINYINT NULL
  elimination_reason : VARCHAR(32) NULL
  eliminated_at_ms : INT NULL
  launch_summary_json : JSON NULL
  * connection_outcome : ENUM(OK,DISCONNECTED,NO_SHOW)
}
entity match_event <<P>> {
  * match_id : FK
  * seq : INT
  --
  * t_ms : INT
  * type : VARCHAR(32)
  payload_json : JSON
}
entity competitive_record <<P>> {
  * user_id : PK FK
  --
  * matches_played : INT
  * wins : INT
  * placements_json : JSON
  rating : DECIMAL(8,2) NULL [TBD ADR-009]
  rating_deviation : DECIMAL(8,2) NULL [TBD]
  * updated_at : DATETIME(3)
}
entity team <<C>> {
  * id : BIGINT PK
  --
  * name : VARCHAR(32) UNIQUE
  * tag : VARCHAR(5) UNIQUE
  description : VARCHAR(500)
  * status : ENUM(ACTIVE,DISSOLVED)
  * created_by : FK
  * created_at : DATETIME(3)
}
entity team_membership <<C>> {
  * id : BIGINT PK
  --
  * team_id : FK
  * user_id : FK
  * role : ENUM(LEADER,MEMBER)
  * joined_at : DATETIME(3)
  left_at : DATETIME(3) NULL
  left_reason : ENUM(LEFT,REMOVED,DISSOLVED) NULL
}
entity team_invitation <<P>> {
  * id : BIGINT PK
  --
  * team_id : FK
  * user_id : FK
  * direction : ENUM(INVITE,REQUEST)
  * status : ENUM(PENDING,ACCEPTED,DECLINED,CANCELLED,EXPIRED)
  * created_by : FK
  * created_at : DATETIME(3)
}
entity user_block <<P>> {
  * blocker_id : FK
  * blocked_id : FK
  --
  * created_at : DATETIME(3)
}
entity report <<C>> {
  * id : BIGINT PK
  --
  * reporter_id : FK
  * reported_id : FK
  match_id : FK NULL
  * reason : ENUM(CHEATING,HARASSMENT,OFFENSIVE_NAME,OTHER) [P]
  details : VARCHAR(1000)
  * status : ENUM(OPEN,IN_REVIEW,ACTIONED,DISMISSED)
  * created_at : DATETIME(3)
}
entity moderation_action <<P>> {
  * id : BIGINT PK
  --
  * target_user_id : FK
  * moderator_id : FK
  report_id : FK NULL
  * action : ENUM(WARN,MUTE,SUSPEND,BAN,RENAME,LIFT)
  * reason : VARCHAR(500)
  expires_at : DATETIME(3) NULL
  * created_at : DATETIME(3)
}
entity audit_log <<P>> {
  * id : BIGINT PK
  --
  actor_user_id : FK NULL (NULL = system)
  * action : VARCHAR(64)
  * target_type : VARCHAR(32)
  * target_id : VARCHAR(64)
  metadata_json : JSON
  * created_at : DATETIME(3)
}
entity organizer_application <<C>> {
  * id : BIGINT PK
  --
  * user_id : FK
  * status : ENUM(PENDING,APPROVED,REJECTED,REVOKED)
  motivation : VARCHAR(1000)
  reviewed_by : FK NULL
  reviewed_at : DATETIME(3) NULL
  * created_at : DATETIME(3)
}
entity tournament <<post>> {
  * id : BIGINT PK
  --
  * organizer_id : FK
  [fields TBD OQ-AC-06]
}

user_account ||--o{ auth_session
user_account ||--|| player_profile
user_account ||--o{ user_role
role ||--o{ user_role
user_account ||--o{ inventory_item
item_definition ||--o{ inventory_item
user_account ||--o{ loadout
loadout ||--|{ loadout_slot
inventory_item ||--o{ loadout_slot
user_account ||--o{ room : hosts
room ||--o{ room_member
user_account ||--o{ room_member
room |o--o{ game_match
game_match ||--|{ match_participant
user_account ||--o{ match_participant
game_match ||--o{ match_event
user_account ||--|| competitive_record
team ||--|{ team_membership
user_account ||--o{ team_membership
team ||--o{ team_invitation
user_account ||--o{ user_block
user_account ||--o{ report
game_match |o--o{ report
report |o--o{ moderation_action
user_account ||--o{ moderation_action
user_account |o--o{ audit_log
user_account ||--o{ organizer_application
user_account ||--o{ tournament
@enduml
