@startuml SQ-07
title SQ-07 Match completion & result persistence [P]
participant "Match Server" as MS
participant "All Clients" as C
participant "Backend API" as B
database MySQL as DB
MS -> MS : remaining <= 1 (or time limit/sudden death [TBD])
MS -> MS : MatchResult {matchId, endReason, placements[],\neliminations[{userId, finishType (physical), outcomeReason, tick, creditedTo}],\nlaunch[{presses, launchRps, flags}], skillUses[], finalSpin[],\nfinalLock[], durationMs, contentVersion, seed}
MS -> C : S2C_MatchEnded {placements, finishTypes} (provisional)
MS -> B : POST /internal/v1/matches/{matchId}/result\nAuthorization: Service <secret>; Idempotency-Key: matchId
B -> B : validate: instance owns match, participants = allocation,\nplacements consistent, finish types valid
B -> DB : BEGIN; game_match COMPLETED; match_participant (placement,\nfinish_type, outcome_reason, launch_presses, launch_rps, ...);\nmatch_event summaries; competitive_record; room status; COMMIT
alt first report
  B --> MS : 200 {persisted: true}
else duplicate
  B --> MS : 200 {persisted: true, duplicate: true}
else invalid
  B --> MS : 422 RESULT_REJECTED; match DISPUTED + alert
end
B -> C : Reverb: match.completed {matchId}
note over MS : On 5xx/timeout: retry with backoff (journal file)\nuntil accepted (NFR-031)
MS -> MS : reset; heartbeat {state: IDLE}
@enduml
