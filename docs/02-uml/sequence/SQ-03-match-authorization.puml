@startuml SQ-03
title SQ-03 Start Match: Allocation & Match Authorization [P — heartbeat-pull, ADR-012 §5]
actor Host
participant "Clients (all\nroom members)" as C
participant "Backend API\n(Laravel + Reverb)" as B
participant "Match Server\n(IDLE pool process)" as MS
database MySQL as DB
loop every 1 s (always)
  MS -> B : POST /internal/v1/servers/{instanceId}/heartbeat\n{state, matchId?, ackedCommandIds[]}
  B -> DB : UPSERT match_server_instance (last_heartbeat_at)
  B --> MS : 200 {commands[]}  (pending rows of match_server_command)
end
Host -> C : Start
C -> B : POST /v1/rooms/{roomId}/start
B -> DB : SELECT room, members FOR UPDATE
alt not host / not all ready / competitors < 2 (A-01) / > 5
  B --> C : 403 NOT_HOST | 409 NOT_READY | 409 NOT_ENOUGH_PLAYERS
else ok
  B -> DB : SELECT IDLE instance (matching protocolVersion,\nheartbeat < 3 s old) FOR UPDATE SKIP LOCKED
  alt none available
    B --> C : 503 NO_SERVER_AVAILABLE + alert (OPS-003)
  else instance found
    B -> B : compute build snapshots (attributes, Energy,\ntype, properties, skill) per competitor
    B -> B : ticket = 256-bit random per member;\nstore SHA-256(ticket), userId, role, exp=now+60 s
    B -> DB : INSERT game_match(ALLOCATING), match_participant (+snapshots),\nmatch_server_command(AssignMatch{participants, ticketHashes,\ncontentVersion, seed}); instance BUSY; room STARTING
    B --> C : 202 {matchId, status: ALLOCATING}
  end
end
MS -> B : heartbeat
B --> MS : {commands: [AssignMatch]}
MS -> MS : load content_version, init match
MS -> B : heartbeat {ackedCommandIds:[AssignMatch]}
B -> DB : game_match WAITING_FOR_PLAYERS
B -> C : Reverb private-user.{id}: match.allocated\n{matchId, host, udpPort, own ticket}
C -> MS : ENet connect host:udpPort
C -> MS : C2S_Hello {ticket, protocolVersion, matchId}
MS -> MS : hash(ticket) expected? unexpired? unused? protocol ok?
alt valid
  MS --> C : S2C_Welcome {role, slot, phase, serverTime, participants+builds}
else invalid
  MS --> C : S2C_Kick {TICKET_INVALID}
end
@enduml
