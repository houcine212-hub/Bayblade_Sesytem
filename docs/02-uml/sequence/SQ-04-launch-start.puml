@startuml SQ-04
title SQ-04 READY, 5-second rapid-press LAUNCH and battle start [C mechanic / P validation]
participant "Competitor Client" as C
participant "Spectator Clients" as S
participant "Match Server" as MS
participant "Backend API" as B
C -> MS : C2S_Ping x5 (during WAITING) 
MS --> C : S2C_Pong (clock offset Δ, RTT)
MS -> C : S2C_PhaseChanged {READY, launchWindowStartServerMs = W0}
MS -> S : S2C_PhaseChanged {READY}
C -> C : show launch zone + 3-2-1 cue (presses not counted)
MS -> C : S2C_PhaseChanged {LAUNCH_WINDOW, W0, durationMs: 5000}
loop every 100 ms during window
  C -> C : count edge-triggered presses in zone\n(no key-repeat, release required)
  C -> MS : C2S_LaunchPressBatch {seq[], tClientMs[]} (reliable)
  MS -> MS : t = tClient + Δ; accept if W0 <= t <= W0+5000,\nnot future, not back-dated > RTT/2+250 ms,\ninterval >= 83.3 ms (12 Hz cap)
end
MS -> MS : at W0+5000+300 ms grace: n = accepted presses\nlaunchRps = 20 + 130*(1 - e^(-n/19.06)); flags (regularity)
MS -> C : S2C_LaunchResult {all: userId, presses, launchRps}
MS -> S : S2C_LaunchResult
MS -> C : S2C_PhaseChanged {RELEASE} then {BATTLE, opening 3 s}
MS -> B : POST /internal/v1/matches/{id}/state {BATTLE, launchSummaries}
loop 30 Hz
  MS -> C : S2C_Snapshot {tick, tops[pos, rot, vel, spinRps, burstStage, skillState]}
  MS -> S : S2C_Snapshot
end
@enduml
