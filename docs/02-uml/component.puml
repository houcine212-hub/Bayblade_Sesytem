@startuml component
title Component Diagram [P]
skinparam componentStyle rectangle

package "Game Client (Godot 4.x, GDScript)" {
  [UI / Screens\n(menus, lobby, HUD, results)] as UI
  [Input Adapter\n(touch / keyboard+mouse / gamepad later)] as INP
  [API Client\n(HTTPS + WSS events)] as APIC
  [Match Net Client\n(ENet peer, interpolation buffer)] as MNC
  [Presentation\n(3D arena, tops, VFX, camera)] as PRES
  [Shared Rules Lib\n(content schema, protocol defs)] as SRL_C
  [Quality Settings\n(device tiers)] as QS
}
package "Match Server (headless Godot, same project)" {
  [Control Channel Client\n(WS to Backend internal)] as CCC
  [Session Gate\n(ticket check, peer roles)] as GATE
  [Match Controller\n(state machine, rules)] as MC
  [Battle Simulation\n(fixed tick)] as SIM
  [Snapshot Replicator] as REP
  [Result Reporter\n(+ local journal)] as RR
  [Shared Rules Lib] as SRL_S
}
package "Backend API (Node.js LTS + TypeScript [P])" {
  [HTTP Router + Validation] as RT
  [Auth Module] as AUTH
  [Profile & Inventory Module] as PROF
  [Room Module] as ROOM
  [Match Allocator] as ALLOC
  [Match Record Module] as MREC
  [Social Module\n(teams, blocks)] as SOC
  [Moderation & Admin Module] as MOD
  [Realtime Events Hub (WSS)] as EVT
  [Internal Control Endpoint\n(WS + result POST)] as ICE
  [Data Access Layer\n(repositories, migrations)] as DAL
}
database "MySQL 8.4" as DB
folder "Content Data\n(items, arenas, balance;\nversioned JSON/Resources)" as CONTENT

UI --> APIC
UI --> MNC
INP --> MNC
MNC --> PRES
QS --> PRES
APIC --> RT : HTTPS
APIC --> EVT : WSS
MNC --> GATE : ENet/UDP
GATE --> MC
MC --> SIM
SIM --> REP
REP --> MNC : snapshots
MC --> RR
RR --> ICE : HTTP (internal)
CCC --> ICE : WS (internal)
CCC --> MC : AssignMatch / TicketGrant
RT --> AUTH
RT --> PROF
RT --> ROOM
RT --> MREC
RT --> SOC
RT --> MOD
ROOM --> ALLOC
ALLOC --> ICE
ICE --> MREC
ROOM --> EVT
MREC --> EVT
AUTH --> DAL
PROF --> DAL
ROOM --> DAL
MREC --> DAL
SOC --> DAL
MOD --> DAL
DAL --> DB : SQL (localhost)
CONTENT ..> SRL_C
CONTENT ..> SRL_S
CONTENT ..> PROF : item catalog seed
@enduml
